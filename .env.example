# AccessRoute Backend Configuration

# Server Port
PORT=5000

# Environment
NODE_ENV=development

# Supabase PostgreSQL Configuration (Optional - falls back to seeded dataset if empty)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_KEY=

# Google Gemini AI Configuration (Server-Side Only - never expose via VITE_ prefix)
GEMINI_API_KEY=

